PORT=5000

# Supabase project settings — Settings > API Keys in the Supabase dashboard.
# Use the "secret" key here (server-side only), never the publishable key.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-supabase-secret-key

# Google Gemini API key. Required: it is used for the answer call and
# for the LLM judge in backend-core/utils/evalEngine.js.
GEMINI_API_KEY=your-gemini-api-key

