PORT=5000

# Supabase project settings - Settings > API Keys in the Supabase dashboard.
# SUPABASE_ANON_KEY: publishable key (or legacy anon key). Used for sign up / login.
# SUPABASE_SERVICE_KEY: secret key (server-side only, never put it in frontend code).
# It is used to read and write evaluation_logs. If it is missing, the backend
# falls back to SUPABASE_ANON_KEY, and evaluation_logs will then need RLS policies.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-supabase-publishable-key
SUPABASE_SERVICE_KEY=your-supabase-secret-key

# Google Gemini API key. Required: it is used for the answer call and
# for the LLM judge in backend-core/utils/evalEngine.js.
GEMINI_API_KEY=your-gemini-api-key
